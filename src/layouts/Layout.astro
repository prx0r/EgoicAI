---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'truth x ai',
  description = 'hackathon builds'
} = Astro.props;

const fonts = [
  { name: 'Share Tech Mono', var: '--font-share-tech-mono' },
  { name: 'JetBrains Mono', var: '--font-jetbrains-mono' },
  { name: 'IBM Plex Mono', var: '--font-ibm-plex-mono' },
  { name: 'Fira Code', var: '--font-fira-code' },
  { name: 'Space Mono', var: '--font-space-mono' },
  { name: 'Source Code Pro', var: '--font-source-code-pro' },
  { name: 'Inconsolata', var: '--font-inconsolata' },
  { name: 'Roboto Mono', var: '--font-roboto-mono' },
  { name: 'PT Mono', var: '--font-pt-mono' },
  { name: 'Overpass Mono', var: '--font-overpass-mono' },
  { name: 'Victor Mono', var: '--font-victor-mono' },
  { name: 'Courier Prime', var: '--font-courier-prime' },
  { name: 'Geist Mono', var: '--font-geist-mono' },
  { name: 'Inter', var: '--font-inter' },
  { name: 'Space Grotesk', var: '--font-space-grotesk' },
  { name: 'IBM Plex Sans', var: '--font-ibm-plex-sans' },
  { name: 'Outfit', var: '--font-outfit' },
  { name: 'DM Sans', var: '--font-dm-sans' },
  { name: 'Manrope', var: '--font-manrope' },
  { name: 'Nunito', var: '--font-nunito' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />

    <div id="font-picker" style="
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      background: #fff;
      border: 1px solid #ddd;
      padding: 0.75rem;
      font-size: 0.6875rem;
      z-index: 9999;
      max-width: 200px;
    ">
      <div style="margin-bottom: 0.5rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: #999;">
        font
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.375rem;">
        <div id="font-name" style="font-size: 0.625rem; color: #000; letter-spacing: 0.05em;">
          Share Tech Mono
        </div>
        <div style="display: flex; gap: 0.25rem;">
          <button id="prev-font" style="
            flex: 1;
            background: #000;
            color: #fff;
            border: none;
            padding: 0.375rem;
            font-size: 0.625rem;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.1em;
          ">&larr; prev</button>
          <button id="next-font" style="
            flex: 1;
            background: #000;
            color: #fff;
            border: none;
            padding: 0.375rem;
            font-size: 0.625rem;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.1em;
          ">next &rarr;</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function() {
        const fontNames = [
          'Share Tech Mono',
          'JetBrains Mono',
          'IBM Plex Mono',
          'Fira Code',
          'Space Mono',
          'Source Code Pro',
          'Inconsolata',
          'Roboto Mono',
          'PT Mono',
          'Overpass Mono',
          'Victor Mono',
          'Courier Prime',
          'Geist Mono',
          'Inter',
          'Space Grotesk',
          'IBM Plex Sans',
          'Outfit',
          'DM Sans',
          'Manrope',
          'Nunito'
        ];

        let currentIndex = 0;
        const nameEl = document.getElementById('font-name');
        const prevBtn = document.getElementById('prev-font');
        const nextBtn = document.getElementById('next-font');

        function applyFont(index) {
          currentIndex = index;
          const name = fontNames[index];
          document.body.style.fontFamily = '"' + name + '", monospace';
          nameEl.textContent = name;
          localStorage.setItem('selected-font', name);
        }

        prevBtn.addEventListener('click', function() {
          var i = (currentIndex - 1 + fontNames.length) % fontNames.length;
          applyFont(i);
        });

        nextBtn.addEventListener('click', function() {
          var i = (currentIndex + 1) % fontNames.length;
          applyFont(i);
        });

        // Restore saved font
        var saved = localStorage.getItem('selected-font');
        if (saved) {
          var idx = fontNames.indexOf(saved);
          if (idx !== -1) applyFont(idx);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Share Tech Mono', monospace;
    background: #fff;
    color: #000;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.6;
  }

  a {
    color: #000;
    text-decoration: none;
    border-bottom: 1px solid #ccc;
    transition: border-color 0.2s;
  }

  a:hover {
    border-bottom-color: #000;
  }
</style>
