---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'truth x ai',
  description = 'hackathon builds'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=JetBrains+Mono:wght@300;400;500&family=IBM+Plex+Mono:wght@300;400;500&family=Fira+Code:wght@300;400;500&family=Space+Mono&family=Source+Code+Pro:wght@300;400;500&family=Inconsolata:wght@300;400;500&family=Roboto+Mono:wght@300;400;500&family=PT+Mono&family=Overpass+Mono:wght@300;400;500&family=Victor+Mono&family=Courier+Prime&family=Geist+Mono&family=Inter:wght@300;400;500&family=Space+Grotesk:wght@300;400;500&family=IBM+Plex+Sans:wght@300;400;500&family=Outfit:wght@300;400;500&family=DM+Sans:wght@300;400;500&family=Manrope:wght@300;400;500&family=Nunito:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />

    <div id="font-picker" style="
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      background: #fff;
      border: 1px solid #ddd;
      padding: 0.75rem;
      font-size: 0.6875rem;
      z-index: 9999;
      width: 220px;
    ">
      <div style="margin-bottom: 0.5rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: #999;">
        font
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.375rem;">
        <div id="font-name" style="font-size: 0.625rem; color: #000; letter-spacing: 0.05em; min-height: 1em;">
          Share Tech Mono
        </div>
        <div style="display: flex; gap: 0.25rem;">
          <button id="prev-font" style="
            flex: 1;
            background: #000;
            color: #fff;
            border: none;
            padding: 0.375rem;
            font-size: 0.625rem;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.1em;
          ">&larr; prev</button>
          <button id="next-font" style="
            flex: 1;
            background: #000;
            color: #fff;
            border: none;
            padding: 0.375rem;
            font-size: 0.625rem;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.1em;
          ">next &rarr;</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function() {
        var fontNames = [
          'Share Tech Mono',
          'JetBrains Mono',
          'IBM Plex Mono',
          'Fira Code',
          'Space Mono',
          'Source Code Pro',
          'Inconsolata',
          'Roboto Mono',
          'PT Mono',
          'Overpass Mono',
          'Victor Mono',
          'Courier Prime',
          'Geist Mono',
          'Inter',
          'Space Grotesk',
          'IBM Plex Sans',
          'Outfit',
          'DM Sans',
          'Manrope',
          'Nunito'
        ];

        var currentIndex = 0;
        var nameEl = document.getElementById('font-name');
        var prevBtn = document.getElementById('prev-font');
        var nextBtn = document.getElementById('next-font');

        function applyFont(index) {
          currentIndex = index;
          var name = fontNames[index];
          document.body.style.fontFamily = "'" + name + "', monospace";
          nameEl.textContent = name;
          localStorage.setItem('selected-font', name);
        }

        prevBtn.addEventListener('click', function() {
          var i = (currentIndex - 1 + fontNames.length) % fontNames.length;
          applyFont(i);
        });

        nextBtn.addEventListener('click', function() {
          var i = (currentIndex + 1) % fontNames.length;
          applyFont(i);
        });

        var saved = localStorage.getItem('selected-font');
        if (saved) {
          var idx = fontNames.indexOf(saved);
          if (idx !== -1) applyFont(idx);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Share Tech Mono', monospace;
    background: #fff;
    color: #000;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.6;
  }

  a {
    color: #000;
    text-decoration: none;
    border-bottom: 1px solid #ccc;
    transition: border-color 0.2s;
  }

  a:hover {
    border-bottom-color: #000;
  }
</style>
