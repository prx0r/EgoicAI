---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'alethiea' },
      props: {
        name: 'Alethiea',
        description: 'Pāṭala Research CI — continuous verification for agentic science',
        language: 'Python',
        url: 'https://github.com/prx0r/Alethiea',
        updated: '2026-08-19',
        hackathon: 'OpenAIRE AI Hackathon 2026',
        tagline: 'When OpenAIRE evidence changes, agent conclusions break. Alethiea detects the blast radius and emits proof obligations.',
        problem: 'OpenAIRE agents draw conclusions from scholarly metadata. When that metadata changes, conclusions silently break. There is no continuity layer for agent reasoning across evidence updates.',
        solution: 'Records which OpenAIRE observations a conclusion depends on. Detects when those observations change. Emits proof obligations for affected conclusions. Leaves unaffected ones untouched.',
        architecture: [
          'Observation → derived claim → explicit dependency',
          'Source changes → blast radius computed',
          'Affected: PROOF OBLIGATION',
          'Unaffected: NO ACTION NEEDED',
        ],
        techStack: ['Python', 'OpenAIRE MCP', 'Alien Intelligence', 'ScholeXplorer V3'],
      },
    },
  ];
}

const { name, description, language, url, updated, hackathon, tagline, problem, solution, architecture, techStack } = Astro.props;
---

<Layout title={`${name} — egoic.ai`}>
  <main style="max-width: 42rem; margin: 0 auto; padding: 5rem 1.5rem;">
    <header style="margin-bottom: 3rem;">
      <p style="font-size: 0.75rem; color: #999; margin-bottom: 1rem;">
        <a href="/" style="color: #999; text-decoration: none;">egoic.ai</a>
        <span style="margin: 0 0.5rem;">/</span>
        {name}
      </p>
      <h1 style="font-size: 1.5rem; font-weight: 300; margin-bottom: 0.5rem;">
        {name}
      </h1>
      <p style="font-size: 0.875rem; color: #666; line-height: 1.6;">
        {description}
      </p>
    </header>

    <section style="margin-bottom: 3rem;">
      <p style="font-size: 0.8125rem; color: #999; line-height: 1.6; margin-bottom: 1.5rem;">
        {tagline}
      </p>
      <div style="display: flex; gap: 1rem; align-items: center; font-size: 0.75rem; color: #999;">
        <span>{language}</span>
        <span style="color: #ddd;">|</span>
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          style="color: #000; text-decoration: none; border-bottom: 1px solid #ddd;"
        >
          GitHub
        </a>
        <span style="color: #ddd;">|</span>
        <span>{hackathon}</span>
      </div>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 1rem;">
        Problem
      </h2>
      <p style="font-size: 0.875rem; color: #333; line-height: 1.7;">
        {problem}
      </p>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 1rem;">
        Solution
      </h2>
      <p style="font-size: 0.875rem; color: #333; line-height: 1.7;">
        {solution}
      </p>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 1rem;">
        Architecture
      </h2>
      <div style="font-size: 0.8125rem; color: #666; line-height: 2; font-family: monospace;">
        {architecture.map((line: string) => (
          <p>{line}</p>
        ))}
      </div>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 1rem;">
        Tech Stack
      </h2>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        {techStack.map((tech: string) => (
          <span style="font-size: 0.75rem; color: #666; padding: 0.25rem 0.5rem; border: 1px solid #eee;">
            {tech}
          </span>
        ))}
      </div>
    </section>

    <footer style="border-top: 1px solid #eee; padding-top: 2rem; font-size: 0.6875rem; color: #ccc;">
      <p>Built for the OpenAIRE AI Hackathon 2026.</p>
    </footer>
  </main>
</Layout>
