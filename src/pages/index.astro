---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'Alethiea',
    what: 'A verification layer that tracks which scholarly evidence each AI agent conclusion depends on.',
    why: 'When research metadata changes, agent conclusions silently break. Alethiea detects the blast radius and flags every affected claim.',
    hackathon: 'openaire ai hackathon 2026',
    hackathonUrl: 'https://graph.openaire.eu/component/eventbooking/hackathons/openaire-ai-hackathon-powered-by-alien-intelligence',
    github: 'https://github.com/prx0r/Alethiea',
    logo: '/images/alethiea-logo.png',
    duration: '12 weeks',
    prize: '€500',
    status: 'submitted',
  },
  {
    name: 'Iolaus',
    what: 'A benchmark suite that tests whether graph memory systems return correct, attributable, temporally consistent context.',
    why: 'Agent memory retrieves plausible-sounding context. Nobody systematically tests if it is actually right. Iolaus proves it or exposes the failure modes.',
    hackathon: 'hack hydra 2026',
    hackathonUrl: 'https://luma.com/h038glzk',
    github: 'https://github.com/prx0r/Iolaus',
    logo: '/images/iolaus-logo.png',
    duration: '9 days',
    prize: '$5,000',
    status: 'submitted',
  },
];
---

<Layout title="truth x ai">
  <main style="width: 100%; padding: 3rem 2rem;">
    <header style="margin-bottom: 4rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <img src="/favicon.png" alt="egoic" style="width: 56px; height: 56px; object-fit: contain;" />
        <button id="copy-email" style="
          font-family: 'Source Code Pro', monospace;
          font-size: 0.75rem;
          color: #999;
          background: none;
          border: none;
          cursor: pointer;
          padding: 0;
          position: relative;
          display: inline-block;
        ">
          <span id="email-text">tom@egoic.ai</span>
          <span id="copy-feedback" style="
            display: none;
            position: absolute;
            top: -1.25rem;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.625rem;
            color: #000;
            white-space: nowrap;
            pointer-events: none;
          ">copied</span>
        </button>
      </div>
    </header>

    {projects.map((project) => (
      <article style="margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid #eee;">
        <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
          <img src={project.logo} alt={project.name} style="width: 120px; height: 120px; object-fit: contain; flex-shrink: 0;" />
          <div style="flex: 1; min-width: 0;">
            <h2 style="font-size: 0.9375rem; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 0.5rem;">
              {project.name}
            </h2>
            <p style="font-size: 0.8125rem; color: #333; line-height: 1.5; margin-bottom: 0.375rem;">
              <span style="color: #999;">what:</span> {project.what}
            </p>
            <p style="font-size: 0.8125rem; color: #333; line-height: 1.5; margin-bottom: 0.75rem;">
              <span style="color: #999;">why:</span> {project.why}
            </p>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; font-size: 0.6875rem; color: #999; margin-bottom: 0.75rem;">
              <span>{project.duration}</span>
              <span style="color: #ddd;">·</span>
              <span>{project.prize}</span>
              <span style="color: #ddd;">·</span>
              <span style="color: #000;">{project.status}</span>
            </div>
            <div style="display: flex; gap: 1.25rem; font-size: 0.6875rem; color: #666;">
              <a
                href={project.hackathonUrl}
                target="_blank"
                rel="noopener noreferrer"
                style="color: #000; border-bottom: 1px solid #ccc;"
              >
                {project.hackathon}
              </a>
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                style="color: #000; border-bottom: 1px solid #ccc;"
              >
                github
              </a>
            </div>
          </div>
        </div>
      </article>
    ))}
  </main>

  <canvas id="burst-canvas" style="
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10000;
  "></canvas>

  <script is:inline>
    (function() {
      var btn = document.getElementById('copy-email');
      var feedback = document.getElementById('copy-feedback');
      var canvas = document.getElementById('burst-canvas');
      var ctx = canvas.getContext('2d');
      var particles = [];
      var animating = false;

      function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      var colors = ['#ff6b6b','#feca57','#48dbfb','#ff9ff3','#54a0ff','#5f27cd','#01a3a4','#f368e0','#ff6348','#7bed9f','#70a1ff','#ffa502'];

      function createParticles(x, y) {
        for (var i = 0; i < 24; i++) {
          var angle = (Math.PI * 2 * i) / 24;
          var speed = 2 + Math.random() * 4;
          particles.push({
            x: x,
            y: y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life: 1,
            color: colors[Math.floor(Math.random() * colors.length)],
            size: 2 + Math.random() * 3,
          });
        }
      }

      function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        var alive = false;
        for (var i = 0; i < particles.length; i++) {
          var p = particles[i];
          if (p.life <= 0) continue;
          alive = true;
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.05;
          p.life -= 0.025;
          ctx.globalAlpha = p.life;
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        if (alive) {
          requestAnimationFrame(animate);
        } else {
          animating = false;
          particles = [];
        }
      }

      btn.addEventListener('click', function(e) {
        navigator.clipboard.writeText('tom@egoic.ai').then(function() {
          feedback.style.display = 'block';
          setTimeout(function() { feedback.style.display = 'none'; }, 1200);

          var rect = btn.getBoundingClientRect();
          createParticles(rect.left + rect.width / 2, rect.top);
          if (!animating) {
            animating = true;
            animate();
          }
        });
      });
    })();
  </script>
</Layout>
