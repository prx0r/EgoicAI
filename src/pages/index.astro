---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'Alethiea',
    greek: 'ἀλήθεια',
    meaning: 'the unconcealment of what was hidden',
    problem: 'AI reads research papers and makes conclusions. The papers change. The conclusions are now wrong but nobody knows.',
    solution: 'Remembers which papers it read. When they change, tells you exactly which conclusions broke.',
    stack: [
      { name: 'Python', url: 'https://python.org' },
      { name: 'OpenAIRE MCP', url: 'https://github.com/AlienIntelligence/openaire-mcp' },
      { name: 'Alien Intelligence', url: 'https://alienintelligence.com' },
    ],
    hackathon: 'openaire ai hackathon 2026',
    hackathonUrl: 'https://graph.openaire.eu/component/eventbooking/hackathons/openaire-ai-hackathon-powered-by-alien-intelligence',
    github: 'https://github.com/prx0r/Alethiea',
    logo: '/images/alethiea-logo.png?v=2',
    duration: '12 weeks',
    prize: '€500',
    status: 'submitted',
  },
  {
    name: 'Iolaus',
    greek: 'Ἰόλαος',
    meaning: 'he who verified the hydra\'s recall',
    problem: 'AI remembers things in a graph. Sometimes it remembers wrong. Nobody checks.',
    solution: 'Gives it a test with known answers. Shows exactly what it gets wrong and why.',
    stack: [
      { name: 'Python', url: 'https://python.org' },
      { name: 'HydraDB', url: 'https://github.com/HydraDB/HydraDB' },
      { name: 'Cypher', url: 'https://neo4j.com/cypher' },
    ],
    hackathon: 'hack hydra 2026',
    hackathonUrl: 'https://luma.com/h038glzk',
    github: 'https://github.com/prx0r/Iolaus',
    logo: '/images/iolaus-logo.png?v=2',
    duration: '9 days',
    prize: '$5,000',
    status: 'submitted',
  },
];
---

<Layout title="truth x ai">
  <main style="width: 100%; padding: 3rem 2rem;">
    <header style="margin-bottom: 4rem;">
      <button id="copy-email" style="
        font-family: 'Source Code Pro', monospace;
        font-size: 0.75rem;
        color: #999;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        position: relative;
        display: inline-block;
      ">
        <span id="email-text">tom@egoic.ai</span>
        <span id="copy-feedback" style="
          display: none;
          position: absolute;
          top: -1.25rem;
          left: 50%;
          transform: translateX(-50%);
          font-size: 0.625rem;
          color: #000;
          white-space: nowrap;
          pointer-events: none;
        ">copied</span>
      </button>
    </header>

    {projects.map((project) => (
      <article style="margin-bottom: 2.5rem; padding-bottom: 2rem;">
        <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
          <img src={project.logo} alt={project.name} style="width: 120px; height: 120px; object-fit: contain; flex-shrink: 0;" />
          <div style="flex: 1; min-width: 0;">
            <h2 style="font-size: 0.9375rem; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 0.5rem;" title={`${project.greek} — ${project.meaning}`}>
              {project.name}
            </h2>
            <p style="font-size: 0.8125rem; color: #333; line-height: 1.5; margin-bottom: 0.375rem;">
              <span style="color: #8b4545;">problem:</span> {project.problem}
            </p>
            <p style="font-size: 0.8125rem; color: #333; line-height: 1.5; margin-bottom: 0.75rem;">
              <span style="color: #4a6b4a;">solution:</span> {project.solution}
            </p>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {project.stack.map((item: { name: string; url: string }) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="font-size: 0.6875rem; color: #999; border-bottom: 1px solid #ddd; padding-bottom: 1px;"
                >
                  {item.name}
                </a>
              ))}
            </div>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; font-size: 0.6875rem; color: #999; margin-bottom: 0.75rem;">
              <span>{project.duration}</span>
              <span style="color: #ddd;">·</span>
              <span>{project.prize}</span>
              <span style="color: #ddd;">·</span>
              <span style="color: #000;">{project.status}</span>
            </div>
            <div style="display: flex; gap: 1.25rem; font-size: 0.6875rem; color: #666;">
              <a
                href={project.hackathonUrl}
                target="_blank"
                rel="noopener noreferrer"
                style="color: #000; border-bottom: 1px solid #ccc;"
              >
                {project.hackathon}
              </a>
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                style="color: #000; border-bottom: 1px solid #ccc;"
              >
                github
              </a>
            </div>
          </div>
        </div>
      </article>
    ))}
  </main>

  <script is:inline>
    (function() {
      var btn = document.getElementById('copy-email');
      var feedback = document.getElementById('copy-feedback');

      btn.addEventListener('click', function() {
        navigator.clipboard.writeText('tom@egoic.ai').then(function() {
          feedback.style.display = 'block';
          setTimeout(function() { feedback.style.display = 'none'; }, 1200);
        });
      });
    })();
  </script>
</Layout>
