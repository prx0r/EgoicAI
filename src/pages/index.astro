---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'Alethiea',
    slug: 'alethiea',
    greek: 'ἀλήθεια',
    meaning: 'the unconcealment of what was hidden',
    problem: ['AI reads research papers', 'makes conclusions', 'the papers change', 'conclusions are now wrong', 'nobody knows'],
    solution: ['remembers which papers it read', 'when they change', 'tells you exactly which conclusions broke'],
    stack: [
      { name: 'Python', url: 'https://python.org' },
      { name: 'OpenAIRE MCP', url: 'https://github.com/AlienIntelligence/openaire-mcp' },
      { name: 'Alien Intelligence', url: 'https://alienintelligence.com' },
    ],
    hackathon: 'openaire ai hackathon 2026',
    hackathonUrl: 'https://graph.openaire.eu/component/eventbooking/hackathons/openaire-ai-hackathon-powered-by-alien-intelligence',
    github: 'https://github.com/prx0r/Alethiea',
    logo: '/images/alethiea-logo.png?v=4',
    duration: '12 weeks',
    prize: '€500',
    status: 'submitted',
  },
  {
    name: 'Iolaus',
    slug: 'iolaus',
    greek: 'Ἰόλαος',
    meaning: 'he who verified the hydra\'s recall',
    problem: ['AI remembers things in a graph', 'sometimes it remembers wrong', 'nobody checks'],
    solution: ['gives it a test with known answers', 'shows exactly what it gets wrong', 'and why'],
    stack: [
      { name: 'Python', url: 'https://python.org' },
      { name: 'HydraDB', url: 'https://github.com/HydraDB/HydraDB' },
      { name: 'Cypher', url: 'https://neo4j.com/cypher' },
    ],
    hackathon: 'hack hydra 2026',
    hackathonUrl: 'https://luma.com/h038glzk',
    github: 'https://github.com/prx0r/Iolaus',
    logo: '/images/iolaus-logo.png?v=4',
    duration: '9 days',
    prize: '$5,000',
    status: 'submitted',
  },
];
---

<Layout title="truth x ai">
  <main style="width: 100%; padding: 3rem 2rem;">
    <header style="margin-bottom: 4rem;">
      <button id="copy-email" style="
        font-family: 'Source Code Pro', monospace;
        font-size: 0.75rem;
        color: #999;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        position: relative;
        display: inline-block;
      ">
        <span id="email-text">tom@egoic.ai</span>
        <span id="copy-feedback" style="
          display: none;
          position: absolute;
          top: -1.25rem;
          left: 50%;
          transform: translateX(-50%);
          font-size: 0.625rem;
          color: #000;
          white-space: nowrap;
          pointer-events: none;
        ">copied</span>
      </button>
    </header>

    {projects.map((project) => (
      <a
        href={`/project/${project.slug}`}
        style="display: flex; gap: 2rem; align-items: flex-start; margin-bottom: 4rem; padding-bottom: 3rem; text-decoration: none; color: inherit;"
      >
        <img src={project.logo} alt={project.name} style="width: 160px; height: 160px; object-fit: contain; flex-shrink: 0;" />
        <div style="flex: 1; min-width: 0;">
          <h2 style="font-size: 1rem; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 0.125rem;">
            {project.name}
          </h2>
          <p style="font-size: 0.625rem; color: #bbb; margin-bottom: 1rem; letter-spacing: 0.05em;">
            {project.greek} — {project.meaning}
          </p>

          <p style="font-size: 0.6875rem; color: #8b4545; margin-bottom: 0.375rem; text-transform: lowercase; letter-spacing: 0.05em;">problem</p>
          {project.problem.map((line: string) => (
            <p style="font-size: 0.8125rem; color: #333; line-height: 1.6; padding-left: 1rem; position: relative;">
              <span style="position: absolute; left: 0; color: #ddd;">·</span>
              {line}
            </p>
          ))}

          <p style="font-size: 0.6875rem; color: #4a6b4a; margin-top: 0.75rem; margin-bottom: 0.375rem; text-transform: lowercase; letter-spacing: 0.05em;">solution</p>
          {project.solution.map((line: string) => (
            <p style="font-size: 0.8125rem; color: #333; line-height: 1.6; padding-left: 1rem; position: relative;">
              <span style="position: absolute; left: 0; color: #ddd;">·</span>
              {line}
            </p>
          ))}

          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem; margin-bottom: 0.75rem;">
            {project.stack.map((item: { name: string; url: string }) => (
              <span style="font-size: 0.6875rem; color: #999;">
                {item.name}
              </span>
            ))}
          </div>

          <div style="display: flex; gap: 0.75rem; font-size: 0.6875rem; color: #999;">
            <span>{project.duration}</span>
            <span style="color: #ddd;">·</span>
            <span>{project.prize}</span>
            <span style="color: #ddd;">·</span>
            <span style="color: #000;">{project.status}</span>
          </div>
        </div>
      </a>
    ))}
  </main>

  <script is:inline>
    (function() {
      var btn = document.getElementById('copy-email');
      var feedback = document.getElementById('copy-feedback');

      btn.addEventListener('click', function() {
        navigator.clipboard.writeText('tom@egoic.ai').then(function() {
          feedback.style.display = 'block';
          setTimeout(function() { feedback.style.display = 'none'; }, 1200);
        });
      });
    })();
  </script>
</Layout>
