---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'alethiea',
    tagline: 'detects when openaire evidence changes and emits proof obligations for every agent conclusion that silently broke.',
    hackathon: 'openaire ai hackathon 2026',
    hackathonUrl: 'https://graph.openaire.eu/component/eventbooking/hackathons/openaire-ai-hackathon-powered-by-alien-intelligence',
    github: 'https://github.com/prx0r/Alethiea',
    logo: '/images/alethiea-logo.png',
  },
  {
    name: 'iolaus',
    tagline: 'benchmarks whether hydradb recall returns attributable, temporally correct, cross-source consistent context or just plausible noise.',
    hackathon: 'hack hydra 2026',
    hackathonUrl: 'https://luma.com/h038glzk',
    github: 'https://github.com/prx0r/Iolaus',
    logo: '/images/iolaus-logo.png',
  },
];
---

<Layout title="truth x ai">
  <main style="width: 100%; padding: 3rem 2rem;">
    <header style="margin-bottom: 4rem;">
      <h1 style="font-size: 1.125rem; font-weight: 400; letter-spacing: 0.08em;">
        truth x ai
      </h1>
      <p style="font-size: 0.75rem; color: #999; margin-top: 0.375rem;">
        tom@egoic.ai
      </p>
    </header>

    {projects.map((project) => (
      <article style="margin-bottom: 4rem; padding-bottom: 3rem; border-bottom: 1px solid #eee;">
        <div style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1rem;">
          <img src={project.logo} alt={project.name} style="width: 48px; height: 48px; object-fit: contain;" />
          <h2 style="font-size: 1rem; font-weight: 400; letter-spacing: 0.02em; text-transform: lowercase;">
            {project.name}
          </h2>
        </div>
        <p style="font-size: 0.8125rem; color: #333; line-height: 1.6; margin-bottom: 1.5rem; max-width: 50rem;">
          {project.tagline}
        </p>
        <div style="display: flex; gap: 1.5rem; font-size: 0.75rem; color: #666;">
          <a
            href={project.hackathonUrl}
            target="_blank"
            rel="noopener noreferrer"
            style="color: #000; border-bottom: 1px solid #ccc;"
          >
            {project.hackathon}
          </a>
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            style="color: #000; border-bottom: 1px solid #ccc;"
          >
            github
          </a>
        </div>
      </article>
    ))}
  </main>
</Layout>
